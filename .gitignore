# OS
.DS_Store
Thumbs.db

# IDE/Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code session-specific files
.claude/logs/transcripts/
.claude/logs/sessions/*
!.claude/logs/sessions/.gitkeep
.claude/session-state.json
.claude/settings.local.json

# Environment and key material (user implementation)
.env
.env.*
!.env.example
.dev.vars
*.pem
*.key
*.p12
*.pfx

# Dependencies (stack-agnostic)
node_modules/
__pycache__/
*.pyc
venv/
.venv/

# Build outputs (root only: `build/` unanchored also hid .claude/skills/build/)
dist/
/build/
*.egg-info/

# Test coverage
coverage/
.coverage
htmlcov/

# Logs
*.log

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Local archive of superseded assets (never committed)
.claude/_archive/

# Spikes (temporary exploratory code)
spikes/

# Local scratch outputs
demos/
workspace/

# Harness runtime state (never committed)
.claude/salvage/
.claude/agent-memory-local/
.claude/logs/*.db
.claude/logs/*.db-*
.claude/logs/*.log

# Common secret-file names (settings.json denies reading them; never track them either)
secrets.json
credentials.json
.credentials.json

# Maintainer-private files (never track)
.github/pii-patterns.txt
.github/release-waivers.txt
